# Since we're building in AWS, this should keep package fetches from getting throttled
#
# amd64:

deb http://us-east-1.ec2.archive.ubuntu.com/ubuntu/ noble main restricted
deb http://us-east-1.ec2.archive.ubuntu.com/ubuntu/ noble-updates main restricted
deb http://us-east-1.ec2.archive.ubuntu.com/ubuntu/ noble universe
deb http://us-east-1.ec2.archive.ubuntu.com/ubuntu/ noble-updates universe
deb http://us-east-1.ec2.archive.ubuntu.com/ubuntu/ noble multiverse
deb http://us-east-1.ec2.archive.ubuntu.com/ubuntu/ noble-updates multiverse
deb http://us-east-1.ec2.archive.ubuntu.com/ubuntu/ noble-backports main restricted universe multiverse
deb http://security.ubuntu.com/ubuntu noble-security main restricted
deb http://security.ubuntu.com/ubuntu noble-security universe
deb http://security.ubuntu.com/ubuntu noble-security multiverse
