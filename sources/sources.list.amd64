# Since we're building in AWS, this should keep package fetches from getting throttled.
# /etc/apt/mirrors.txt: AWS mirror first, official mirror as fallback.
#
# amd64:

deb mirror+file:/etc/apt/mirrors.txt jammy main restricted
deb mirror+file:/etc/apt/mirrors.txt jammy-updates main restricted
deb mirror+file:/etc/apt/mirrors.txt jammy universe
deb mirror+file:/etc/apt/mirrors.txt jammy-updates universe
deb mirror+file:/etc/apt/mirrors.txt jammy multiverse
deb mirror+file:/etc/apt/mirrors.txt jammy-updates multiverse
deb mirror+file:/etc/apt/mirrors.txt jammy-backports main restricted universe multiverse
deb mirror+file:/etc/apt/mirrors.txt jammy-security main restricted
deb mirror+file:/etc/apt/mirrors.txt jammy-security universe
deb mirror+file:/etc/apt/mirrors.txt jammy-security multiverse
