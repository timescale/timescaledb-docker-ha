# Since we're building in AWS, this should keep package fetches from getting throttled
#
# arm64:

deb http://us-east-1.ec2.ports.ubuntu.com/ubuntu-ports/ noble main restricted
deb http://us-east-1.ec2.ports.ubuntu.com/ubuntu-ports/ noble-updates main restricted
deb http://us-east-1.ec2.ports.ubuntu.com/ubuntu-ports/ noble universe
deb http://us-east-1.ec2.ports.ubuntu.com/ubuntu-ports/ noble-updates universe
deb http://us-east-1.ec2.ports.ubuntu.com/ubuntu-ports/ noble multiverse
deb http://us-east-1.ec2.ports.ubuntu.com/ubuntu-ports/ noble-updates multiverse
deb http://us-east-1.ec2.ports.ubuntu.com/ubuntu-ports/ noble-backports main restricted universe multiverse
deb http://ports.ubuntu.com/ubuntu-ports noble-security main restricted
deb http://ports.ubuntu.com/ubuntu-ports noble-security universe
deb http://ports.ubuntu.com/ubuntu-ports noble-security multiverse
