#!/usr/bin/env bash

# Generate the per-version install layers in the Dockerfile from versions.yaml.
#
# One layer per toolkit version. timescaledb versions before DEB_SINCE build from
# source and share one layer. The newest SEPARATE_MINORS minor versions get one
# layer each, older deb versions share one layer.
#
# usage: gen_dockerfile_versions          rewrite the blocks in the Dockerfile
#        gen_dockerfile_versions --check  exit 1 when the Dockerfile is stale

set -euo pipefail

SCRIPT_DIR="${BASH_SOURCE[0]%/*}"
VERSIONS="$SCRIPT_DIR/versions.yaml"
DOCKERFILE="$SCRIPT_DIR/../Dockerfile"

PG_MAJORS="$(yq '.postgres_versions | keys | .[]' "$SCRIPT_DIR/postgres_versions.yaml" | sort -n | xargs)"
DEFAULT_PG_MIN="$(yq .default-pg-min "$VERSIONS")"
DEFAULT_PG_MAX="$(yq .default-pg-max "$VERSIONS")"
DEB_SINCE=2.24.0
SEPARATE_MINORS=6

version_lt() {
    [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" = "$1" ]
}

# one RUN layer with the lines from stdin
emit_layer() {
    local comment="$1" lines
    lines="$(cat)"
    [ -n "$lines" ] || return 0
    echo "# $comment"
    echo "RUN <<EOF"
    echo "$lines"
    echo "EOF"
}

# release versions of $1, oldest first; branch names are left to the catch-all steps
release_versions() {
    yq ".$1 | keys | .[]" "$VERSIONS" | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V
}

# the pg majors that $1 version $2 supports, same rules as version_is_supported
supported_pgs() {
    local pkg="$1" ver="$2" pdata pgmin pgmax explicit pg out=""
    pdata="$(yq ".${pkg}[\"$ver\"]" "$VERSIONS")"

    if [ "$(yq .arch <<<"$pdata")" != null ]; then
        echo "$pkg-$ver: arch is not supported by $0" >&2
        exit 1
    fi

    pgmin="$(yq .pg-min <<<"$pdata")"
    [ "$pgmin" = null ] && pgmin="$DEFAULT_PG_MIN"
    pgmax="$(yq .pg-max <<<"$pdata")"
    [ "$pgmax" = null ] && pgmax="$DEFAULT_PG_MAX"
    explicit="$(yq '.pg // [] | .[]' <<<"$pdata" | xargs)"

    for pg in $PG_MAJORS; do
        [ "$pg" -ge "${pgmin%%.*}" ] || continue
        [ "$pg" -le "${pgmax%%.*}" ] || continue
        if [ -n "$explicit" ] && [[ " $explicit " != *" $pg "* ]]; then continue; fi
        out="$out $pg"
    done
    echo "${out# }"
}

gen_timescaledb() {
    local ver pgs line minor source="" older="" i first_separate
    local -a minors=()
    declare -A by_minor=()

    for ver in $(release_versions timescaledb); do
        pgs="$(supported_pgs timescaledb "$ver")"
        [ -n "$pgs" ] || continue
        line="/build/scripts/install_extensions timescaledb $ver \"$pgs\""$'\n'
        if version_lt "$ver" "$DEB_SINCE"; then
            source+="$line"
        else
            minor="${ver%.*}"
            [[ " ${minors[*]} " == *" $minor "* ]] || minors+=("$minor")
            by_minor[$minor]+="$line"
        fi
    done

    first_separate=$(( ${#minors[@]} - SEPARATE_MINORS ))
    (( first_separate < 0 )) && first_separate=0
    for (( i = 0; i < first_separate; i++ )); do
        older+="${by_minor[${minors[i]}]}"
    done

    printf '%s' "$source" | emit_layer "built from source, one layer for all"
    printf '%s' "$older" | emit_layer "older deb releases, one layer for all"
    for (( i = first_separate; i < ${#minors[@]}; i++ )); do
        printf '%s' "${by_minor[${minors[i]}]}" | emit_layer "${minors[i]}.x"
    done
}

gen_toolkit() {
    local ver pgs cargopgrx
    for ver in $(release_versions toolkit); do
        pgs="$(supported_pgs toolkit "$ver")"
        [ -n "$pgs" ] || continue
        cargopgrx="$(yq ".toolkit[\"$ver\"].cargo-pgrx" "$VERSIONS")"
        if [ "$cargopgrx" = null ]; then
            echo "toolkit-$ver: cargo-pgrx is required in versions.yaml" >&2
            exit 1
        fi
        echo "RUN /build/scripts/install_extensions toolkit $ver \"$pgs\" $cargopgrx"
    done
}

# replace block $1 in file $3 with the content of file $2
replace_block() {
    local name="$1" content="$2" file="$3" begin end begin_line end_line
    begin="# BEGIN GENERATED $name"
    end="# END GENERATED $name"
    begin_line="$(grep -nxF "$begin" "$file" | cut -d: -f1)"
    end_line="$(grep -nxF "$end" "$file" | cut -d: -f1)"
    [ -n "$begin_line" ] || { echo "marker not found: $begin" >&2; exit 1; }
    [ -n "$end_line" ] || { echo "marker not found: $end" >&2; exit 1; }
    {
        head -n "$begin_line" "$file"
        cat "$content"
        tail -n "+$end_line" "$file"
    } > "$file.tmp"
    mv "$file.tmp" "$file"
}

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# generate into a copy, so an error leaves the Dockerfile untouched
gen_timescaledb > "$tmp/timescaledb"
gen_toolkit > "$tmp/toolkit"

cp "$DOCKERFILE" "$tmp/Dockerfile"
for block in timescaledb toolkit; do
    replace_block "$block" "$tmp/$block" "$tmp/Dockerfile"
done

if [ "${1:-}" = --check ]; then
    if ! diff -u "$DOCKERFILE" "$tmp/Dockerfile"; then
        echo "Dockerfile is out of date, run: make dockerfile" >&2
        exit 1
    fi
else
    cp "$tmp/Dockerfile" "$DOCKERFILE"
fi
