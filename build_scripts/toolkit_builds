#!/usr/bin/env bash

# Print "<toolkit version> <pg major>" for every toolkit build the image needs.
# The Makefile reads this list to fetch or build the toolkit tarballs.
#
# usage: TOOLKIT_VERSIONS=all PG_VERSIONS="18 17" toolkit_builds

# shared_versions.sh reads versions.yaml from the current directory
cd "${BASH_SOURCE[0]%/*}" || exit 1
SCRIPT_DIR=.
. "$SCRIPT_DIR"/shared.sh

for ver in $TOOLKIT_VERSIONS; do
    for pg in $PG_VERSIONS; do
        [ -z "$(supported_toolkit "$pg" "$ver")" ] && echo "$ver $pg"
    done
done
exit 0
