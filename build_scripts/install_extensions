#!/usr/bin/env bash

SCRIPT_DIR="${BASH_SOURCE[0]%/*}"
. "$SCRIPT_DIR"/shared.sh

# Three modes:
# - `install_extensions <timescaledb|rust|pgvectorscale|...>` installs the requested versions.
# - `install_extensions <timescaledb|toolkit> <version> <pg major>` installs one version for
#   one pg major. The *-build stages in the Dockerfile call this.
# - `install_extensions pack <timescaledb|toolkit> <version> <pg major> <tarball>` packs the
#   files that install put in place. `make extension-artifacts` stores the tarball.

usage() {
    echo "usage: $0 [-n] [versions|timescaledb|rust|all|pgvectorscale|toolkit|pg_textsearch]" >&2
    echo "       $0 [-n] <timescaledb|toolkit> <version> <pg major>" >&2
    echo "       $0 pack <timescaledb|toolkit> <version> <pg major> <tarball>" >&2
    exit 1
}

# use every core for the cmake builds
MAKEFLAGS="-j$(nproc)"
export MAKEFLAGS

# chmod in the layer that installed the files; a later chmod copies them into a new layer
fix_so_modes() {
    [ "$DRYRUN" = true ] && return 0
    find /usr/lib/postgresql/*/lib -name '*.so' -perm /111 -user "$(id -un)" -exec chmod -x {} +
}

# install one version for one pg major
install_one_version() {
    local pkg="$1" version="$2" pg="$3" cargopgrx
    [[ -n "$version" && -n "$pg" ]] || usage

    case "$pkg" in
    timescaledb)
        install_timescaledb "$version" "$pg"
        rm -rf /build/timescaledb
        ;;
    toolkit)
        cargopgrx="$(pkg_cargo_pgrx_version toolkit "$version")"
        if [ -z "$cargopgrx" ]; then
            error "no cargo-pgrx version found for toolkit-$version"
            exit 1
        fi
        install_toolkit "$cargopgrx" "$version" "$pg"
        # cargo recreates registry/src from registry/cache
        rm -rf /build/toolkit /usr/local/cargo/registry/src
        ;;
    *) usage;;
    esac
    fix_so_modes
}

# pack the files of one installed version for one pg major
pack_one_version() {
    local pkg="$1" version="$2" pg="$3" out="$4" so glob
    [[ -n "$version" && -n "$pg" && -n "$out" ]] || usage

    # timescaledb[-.]* leaves out timescaledb_toolkit*
    case "$pkg" in
    timescaledb) so="timescaledb-$version.so"; glob='timescaledb[-.]*';;
    toolkit) so="timescaledb_toolkit-$version.so"; glob='timescaledb_toolkit*';;
    *) usage;;
    esac

    if [ ! -s "/usr/lib/postgresql/$pg/lib/$so" ]; then
        error "$pkg-$version is not installed for pg$pg"
        exit 1
    fi
    cd / || exit 1
    find "usr/lib/postgresql/$pg/lib" "usr/share/postgresql/$pg/extension" -name "$glob" | tar -czf "$out" -T -
    log "packed $pkg-$version for pg$pg into $out"
}

[ "$1" = -n ] && { DRYRUN=true; shift; }

[ "$OSS_ONLY" = true ] && log "installing extensions for OSS_ONLY"

what="$1"
[ -z "$what" ] && what=all

if [ "$what" = pack ]; then
    pack_one_version "$2" "$3" "$4" "$5"
    exit 0
fi

if [ -n "$2" ]; then
    install_one_version "$what" "$2" "$3"
    exit 0
fi

if [[ ! "$what" =~ ^versions|timescaledb|rust|all|pgvectorscale|toolkit|pg_textsearch$ ]]; then
    usage
fi

case "$what" in
versions)
    # this outputs the expanded versions
    echo "TIMESCALEDB_VERSIONS=\"$TIMESCALEDB_VERSIONS\""
    echo "TOOLKIT_VERSIONS=\"$TOOLKIT_VERSIONS\""
    echo "PGVECTORSCALE_VERSIONS=\"$PGVECTORSCALE_VERSIONS\""
    exit 0
    ;;

timescaledb | all)
    for ver in $TIMESCALEDB_VERSIONS; do
        install_timescaledb "$ver"
    done
    # the source tree and build directory are not needed after install
    rm -rf /build/timescaledb
    ;;& # fallthrough to get rust as well if we're called with 'all'

pgvectorscale | all)
    for ver in $PGVECTORSCALE_VERSIONS; do
        install_pgvectorscale "$ver"
    done
    ;;& # fallthrough to get rust as well if we're called with 'all'

rust | all) install_rust_extensions;;

toolkit) install_rust_extensions;;

pg_textsearch | all)
    install_pg_textsearch
    ;;

esac

fix_so_modes
