// Copy of default.json5 from timescale/renovate-config at a520923684.
// The Mend Renovate app does not resolve presets from that private repo in
// a public repo, so the rules live here. Update this copy by hand when the
// shared preset changes.
// The org default still applies secure-registry.json5, own-releases.json5
// and security-alerts.json5. This repo has no npm packages, so it does not
// extend own-releases.json5 again after config:best-practices.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // config:best-practices adds digest pins for Docker images and GitHub
  // Actions, configMigration and abandonment checks on top of
  // config:recommended.
  extends: [
    'config:best-practices',
    'mergeConfidence:all-badges',
    'schedule:weekly',
    // The pre-commit manager is off by default. It updates the rev of each
    // hook repo in .pre-commit-config.yaml (pre-commit and prek).
    ':enablePreCommit',
  ],
  labels: [
    'dependencies',
  ],
  semanticCommitType: 'chore',
  minimumReleaseAge: '7 days',
  prConcurrentLimit: 10,
  mise: {
    // The defaults cover .config/mise/conf.d but not .mise/conf.d.
    managerFilePatterns: [
      '/(^|/)\\.mise/conf\\.d/[^/]+\\.toml$/',
    ],
  },
  customManagers: [
    {
      // Tracks any pin with a comment on the line above it, so a repo needs
      // no own regex manager:
      //   # renovate: datasource=<ds> depName=<name> [packageName=<p>] [versioning=<v>] [extractVersion=<re>]
      customType: 'regex',
      description: 'Pins annotated with a "# renovate:" comment',
      managerFilePatterns: [
        '/(^|/)Dockerfile[^/]*$/',
        '/(^|/)[^/]*\\.Dockerfile$/',
        '/(^|/)Makefile$/',
        '/(^|/)[^/]*\\.mk$/',
        // Any YAML: workflows, actions, compose, Helm values, k8s manifests.
        '/\\.ya?ml$/',
        '/\\.sh$/',
        '/\\.toml$/',
        '/\\.(tf|tfvars|hcl)$/',
        '/(^|/)\\.env[^/]*$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: packageName=(?<packageName>[^\\s]+))?(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s+[^\\n]*?(?::=|[:=])\\s*["\']?(?<currentValue>[^"\'\\s]+)',
      ],
      // A template wins over a capture group, so fall back only when the
      // comment has no versioning.
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}',
    },
    // This repo only, not in the shared preset.
    {
      // The Dockerfile checks that each tag clone is at the commit of its
      // _SHA pin. So Renovate must change the tag and the commit in one PR:
      //   # renovate-digest: datasource=github-tags depName=<owner>/<repo>
      //   NAME?=<tag>
      //   NAME_SHA?=<commit>
      // For an annotated tag, github-tags gives the commit, not the tag object.
      customType: 'regex',
      description: 'Makefile tag pins with a "# renovate-digest:" comment and a _SHA pin on the next line',
      managerFilePatterns: [
        '/(^|/)Makefile$/',
      ],
      matchStrings: [
        '# renovate-digest: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n[A-Z0-9_]+\\?=(?<currentValue>[^\\s]+)\\n[A-Z0-9_]+_SHA\\?=(?<currentDigest>[0-9a-f]{40})',
      ],
      versioningTemplate: 'semver-coerced',
    },
    {
      // The build checks out a commit of a branch, not a tag. Renovate
      // follows the head of the branch and changes the commit:
      //   # renovate-branch: datasource=git-refs depName=<name> packageName=<git URL> branch=<branch>
      //   NAME=<commit>
      customType: 'regex',
      description: 'Commit pins that follow a branch, with a "# renovate-branch:" comment',
      managerFilePatterns: [
        '/(^|/)Makefile$/',
        '/(^|/)Dockerfile$/',
      ],
      matchStrings: [
        '# renovate-branch: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+) packageName=(?<packageName>[^\\s]+) branch=(?<currentValue>[^\\s]+)\\n[^\\n]*?=(?<currentDigest>[0-9a-f]{40})',
      ],
    },
  ],
  packageRules: [
    {
      description: 'One weekly PR for every non-major update not handled by a more specific rule. Majors stay out so that one breaking bump does not block the rest.',
      groupName: 'non-major dependencies',
      // renovate-approve (installed on all org repos) approves the PR, and
      // it merges when its checks pass. Only these update types: majors and
      // lockfile maintenance (which can cross a major) stay manual.
      automerge: true,
      matchUpdateTypes: [
        'digest',
        'patch',
        'minor',
        'pin',
        'pinDigest',
      ],
    },
    {
      description: 'Label major updates for manual review',
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'major-update',
      ],
    },
    {
      description: 'Group GitHub Actions updates into a single PR, majors included',
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github actions',
      separateMajorMinor: false,
    },
    {
      description: 'Group docker-compose image updates into a single PR',
      matchManagers: [
        'docker-compose',
      ],
      groupName: 'docker-compose images',
    },
    {
      // config:best-practices sets npm to 3 days in a preset rule, which
      // overrides the top-level 7 days. Lockfile, pin and other updates
      // without a release timestamp keep the preset value. Our own packages
      // are left out, so that the own-releases.json5 rule stays in effect.
      description: 'npm: 7-day gate, same as every other datasource',
      matchDatasources: [
        'npm',
      ],
      matchPackageNames: [
        '!@timescale/**',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      minimumReleaseAge: '7 days',
    },
    // This repo only, not in the shared preset. These rules come last, so
    // they replace the group and automerge of the rules above.
    {
      description: 'Our own extensions: one PR that a person merges, so we choose when an extension release goes into the image',
      matchManagers: [
        'custom.regex',
      ],
      matchPackageNames: [
        'timescale/**',
      ],
      groupName: 'timescale extensions',
      automerge: false,
    },
    {
      // git-refs gives no release timestamp. With the 7-day gate, Renovate
      // holds the update forever. A person merges this PR, so the gate is off.
      description: 'The timescaledb-docker commit pin goes in the timescale extensions PR',
      matchDepNames: [
        'timescale/timescaledb-docker',
      ],
      groupName: 'timescale extensions',
      automerge: false,
      minimumReleaseAge: null,
    },
    {
      // Renovate changes only the version. The build fails until a person
      // adds the sha256 values of the new release to the PR. A separate
      // group keeps that failure out of the non-major group.
      description: 'Downloads that the build checks against sha256 values in this repo',
      matchDepNames: [
        'prometheus-community/pgbouncer_exporter',
        'woblerr/pgbackrest_exporter',
        'tensorchord/VectorChord',
        'mikefarah/yq',
      ],
      groupName: 'sha256-pinned downloads',
      automerge: false,
    },
    {
      // The _SHA pins exist to stop a tag that moves upstream. A digest
      // update for the same tag means that the tag moved, so a person
      // checks it.
      description: 'Digest updates of the "# renovate-digest:" tag pins',
      matchManagers: [
        'custom.regex',
      ],
      matchDatasources: [
        'github-tags',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      groupName: 'moved upstream tags',
      automerge: false,
    },
    {
      // CI builds through make, and the Makefile DOCKER_FROM build arg
      // replaces this ARG default. So a PR for the default does not change
      // the image.
      description: 'No updates for the ubuntu default of the Dockerfile DOCKER_FROM ARG',
      matchDatasources: [
        'docker',
      ],
      matchDepNames: [
        'ubuntu',
      ],
      enabled: false,
    },
  ],
}
